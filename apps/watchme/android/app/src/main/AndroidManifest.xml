<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- watchme controls TVs over the local network. Flutter adds INTERNET
         only to debug and profile builds; release builds need it here. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- SSDP and mDNS replies are multicast, which Android drops unless the
         app holds a WifiManager.MulticastLock. These permissions let it take
         one; acquiring the lock needs platform code that M0 does not have
         yet (planned in the watchme_platform plugin), so on Android discovery
         may find nothing and devices are added by IP. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- Android 17 gates LAN TCP/UDP (including mDNS and SSDP) behind this
         runtime permission for apps targeting SDK 37. Declared now; the
         runtime request is added together with the SDK 37 target. Older
         platforms ignore it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK"/>
    <!-- usesCleartextTraffic: TVs speak plain HTTP on the LAN (Roku ECP on
         8060, the Fire TV DIAL server on 8009). dart:io does not consult this
         flag today, but platform HTTP clients do. -->
    <application
        android:label="watchme"
        android:usesCleartextTraffic="true"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
