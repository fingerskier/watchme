<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Outgoing connections to TVs: HTTP (Roku ECP, DIAL), HTTPS (Fire TV),
	     SSDP M-SEARCH and Wake-on-LAN datagrams. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Listening sockets: the mDNS querier binds UDP 5353, and discovery
	     replies arrive on bound UDP sockets. Debug builds also need it for the
	     Dart VM service. -->
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
