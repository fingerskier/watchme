<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outgoing connections to TVs: HTTP (Roku ECP, DIAL), HTTPS (Fire TV),
	     SSDP M-SEARCH and Wake-on-LAN datagrams. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Listening sockets: the mDNS querier binds UDP 5353, and discovery
	     replies arrive on bound UDP sockets. macOS needs no multicast
	     entitlement; macOS 15+ shows the Local Network prompt instead (see
	     NSLocalNetworkUsageDescription in Info.plist). -->
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
